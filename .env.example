# ---------------------------------------------------------------------------
# StudyBud (Next.js App Router)
# ---------------------------------------------------------------------------

# Public Supabase connection values. Safe to expose in the browser bundle —
# never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# The older Vite-era names are still read as a fallback, so an existing
# deployment that already has them does not need to be renamed. When both are
# present the NEXT_PUBLIC_ values win.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only. Used by the `generateAIFlashcards` Server Action. Never prefix
# this with NEXT_PUBLIC_.
GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_API_KEY

# Optional: absolute origin used for Supabase email-confirmation links when the
# request has no Origin header (for example during a scripted sign-up).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
