# Copy to .env.local for local development. Never commit real credentials.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Do not add a Gemini API key here. Client-side VITE_ variables are public.
# Gemini calls should move to a server-side endpoint before production use.
