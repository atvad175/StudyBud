# Browser build variables. These values are public and must never include service-role secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side API variables. Set in Vercel Project Settings -> Environment Variables.
# Use the corresponding Supabase project URL and publishable/anon key for token verification.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_API_KEY

# Keep the Gemini key server-side: NEVER name it VITE_GEMINI_API_KEY.
# For local full-stack development, use: npx vercel dev
# npm run dev only starts Vite and does not run the /api serverless function.
